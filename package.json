{
  "name": "monet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monet \u2014 a macOS Markdown vault with a 3D graph, and a CLI that speaks to the same vault.",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "pnpm --filter @monet/cli build",
    "test": "pnpm --filter @monet/cli test",
    "typecheck": "pnpm --filter @monet/cli typecheck",
    "seed": "pnpm --filter @monet/cli seed ExampleVault --notes 60",
    "dev": "pnpm --filter @monet/cli dev"
  },
  "engines": {
    "node": ">=22"
  }
}
