{
  "name": "@monet/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monet — a quiet, local-first Markdown vault for the desktop.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "package:mac": "node scripts/build.mjs && pnpm exec electron-builder --mac",
    "package:win": "node scripts/build.mjs && pnpm exec electron-builder --win nsis zip",
    "package:linux": "node scripts/build.mjs && pnpm exec electron-builder --linux AppImage deb",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.19.0",
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.1",
    "@monet/core": "workspace:*",
    "@types/d3-force": "^3.0.10",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "d3-force": "^3.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.2.0"
  },
  "license": "MIT",
  "author": "Monet contributors",
  "homepage": "https://github.com/felipebarcelospro/monet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipebarcelospro/monet.git"
  },
  "bugs": {
    "url": "https://github.com/felipebarcelospro/monet/issues"
  },
  "keywords": [
    "markdown",
    "notes",
    "vault",
    "electron",
    "react",
    "codemirror"
  ]
}
