{
  "name": "@monet/cli",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "Monet — command line access to a Monet Markdown vault.",
  "license": "MIT",
  "bin": {
    "monet": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "MonetSkill"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/bin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/bin.ts",
    "seed": "tsx scripts/seed.ts",
    "build:binary": "incur build ./dist/bin.js --installer --name monet",
    "prepack": "pnpm build && node scripts/copy-skill.mjs",
    "prebuild": "pnpm --filter @monet/core build",
    "pretypecheck": "pnpm --filter @monet/core build",
    "predev": "pnpm --filter @monet/core build"
  },
  "dependencies": {
    "@monet/core": "workspace:*",
    "incur": "^0.7.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipebarcelospro/monet.git"
  },
  "author": "Monet contributors",
  "homepage": "https://github.com/felipebarcelospro/monet#readme",
  "bugs": {
    "url": "https://github.com/felipebarcelospro/monet/issues"
  },
  "keywords": [
    "markdown",
    "notes",
    "vault",
    "cli",
    "mcp",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public"
  }
}
